# Copy to .env and fill in your own values. Never commit .env.

# Timezone used by the schedule trigger
GENERIC_TIMEZONE=Europe/Madrid
TZ=Europe/Madrid

# Claude model used to score offers
JOBSCOUT_MODEL=claude-haiku-4-5-20251001

# Minimum fit score (0-100) for an offer to appear in the digest
JOBSCOUT_MIN_SCORE=70

# Maximum offers scored per run (controls API cost)
JOBSCOUT_MAX_OFFERS=40

# Telegram chat that receives the daily digest
TELEGRAM_CHAT_ID=
